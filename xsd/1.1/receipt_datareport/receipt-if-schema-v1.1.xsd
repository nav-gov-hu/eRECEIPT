			<xs:documentation xml:lang="hu">Számlázó szoftverek lekérdezéséhez használt típus
      </xs:documentation>
			<xs:documentation xml:lang="en">Type used to query receipt issuing software</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ntcaService:BaseRequestType">
				<xs:sequence>
					<xs:element name="taxPayerId" type="ntcaCustomer:TaxpayerIdType">
						<xs:annotation>
							<xs:documentation xml:lang="hu">Az adószám nyolc jegyű törzsszám része</xs:documentation>
							<xs:documentation xml:lang="en">The 8-digit core number section of the tax number</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="IssuingSoftwareListRequest">
		<xs:annotation>
			<xs:documentation xml:lang="hu">Számlázó szoftverek lekérdezéséhez használt kérés
      </xs:documentation>
			<xs:documentation xml:lang="en">Request used to query receipt issuing software</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="IssuingSoftwareListRequestType"/>
			</xs:complexContent>
		</xs:complexType>
