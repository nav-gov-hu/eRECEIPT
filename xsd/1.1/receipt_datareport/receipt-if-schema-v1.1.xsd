			<xs:element name="software" type="IssuingSoftwareType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="hu">Számlázó szoftver lista.</xs:documentation>
					<xs:documentation xml:lang="en">Receipt issuing software list.</xs:documentation>
				</xs:annotation>
			</xs:element>
